# Application
APP_ENV=local
LOG_LEVEL=INFO
ALLOW_SYNTHETIC_DEMO_ONLY=true

# CockroachDB
DATABASE_URL=postgresql://root@localhost:26257/bonetwin?sslmode=disable
WORKFLOW_STORE_MODE=cockroach
COCKROACH_CLUSTER_ID=
MCP_READONLY_DATABASE=
COCKROACH_MCP_MODE=disabled
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_API_KEY=
COCKROACH_MCP_TIMEOUT_SECONDS=30
DB_TRANSACTION_MAX_RETRIES=5
DB_TRANSACTION_BASE_DELAY_SECONDS=0.025
DB_TRANSACTION_MAX_DELAY_SECONDS=0.5

# AWS document workflow. Local mock mode requires no AWS key or account.
AWS_REGION=us-west-2
AWS_PROFILE=
AWS_DOCUMENT_PIPELINE_MODE=mock
RAW_DOCUMENT_STORE_MODE=filesystem
S3_DOCUMENT_BUCKET=
S3_DOCUMENT_PREFIX=bonetwin/raw-local
KMS_KEY_ARN=
RAW_DOCUMENT_RETENTION_DAYS=1
S3_PRESIGNED_URL_EXPIRY_SECONDS=900

# Authentication (configured in Phase 2)
AUTH_MODE=mock
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_BONETWIN_API_URL=http://127.0.0.1:8000

# Amazon Bedrock. Set live only when using credentialed local Bedrock mode.
BEDROCK_MODE=offline
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
BEDROCK_TIMEOUT_SECONDS=60

# AgentCore is a later hosted-runtime option; local Bedrock mode does not require it.
AGENTCORE_RUNTIME_ARN=
